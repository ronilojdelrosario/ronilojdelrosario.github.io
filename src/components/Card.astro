---
import { Image } from 'astro:assets';
const {title,desc,img_src,url,date} = Astro.props
---

<div class="card">
    <div class="container">
        <a href={url}>
            <div class="img-container">
                <Image src={img_src} alt={img_src}/>
            </div>
            <h1><b>{title}</b></h1>
        </a>
        <p><i>{date}</i></p>
        <p>{desc}</p>
    </div>
</div>

<style>
    .card {
        position: relative;
        width: 35vw;
        border-radius: 20px;
        background-color: rgb(32,31,40);
		font-family: var(--font-lexend), Arial, sans-serif;
    }
    .card:hover{
        background-color: rgba(32,31,40,0.5);
        box-shadow: 0 0 5px 3px rgba(0, 0, 0, 0.4);
    }
    .container {
        padding: 2px 16px;
        color: white;
    }
    a {
        text-decoration: none;
        color: unset;
    }
    h1 {
        font-size: 20px;
    }
    p {
        font-size: 16px;
        line-height: 1.5;
    }
    .img-container{
        margin-top: 1em;
        max-width: 100%;
        aspect-ratio: 20/10;
        overflow: hidden;
    }
    img{
        max-width: 100%;
        width: auto;
        height: auto;
        border-radius: 3px;
    }

    @media screen and (max-width: 768px) {
        .card {
            width: 100%;
            min-width: 80vw;
            margin: auto;
        }
    }
</style>